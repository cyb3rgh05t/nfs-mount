# NFS-MergerFS Manager Configuration
TZ=Europe/Berlin
WEB_PORT=8080

# Role & Performance Switches
# ENABLE_NFS_SERVER: 'true' auf Storage-Nodes, 'false' auf reinen Streaming-Clients
ENABLE_NFS_SERVER=false
# NETWORK_SPEED: '10G' (128MB Puffer) oder '1G' (32MB Puffer)
NETWORK_SPEED=10G
NFS_THREADS=512

# Security & Admin Defaults
JWT_SECRET=change-me-to-a-secure-random-string
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=admin

# API Security (leave empty to disable auth)
API_KEY=

# CORS
CORS_ORIGINS=https://nfs.deinedomain.com

# Discord Notifications
DISCORD_WEBHOOK=

# Telegram Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_ID=

SERVER_NAME=
